---
// src/components/GoogleReviews.astro

interface Review {
  author: string;
  reviewsCount: string;
  rating: number;
  date: string;
  comment: string;
  vehicle?: string;
}

const googleReviews: Review[] = [
  {
    author: "Nestor Stuchi",
    reviewsCount: "6 opiniones",
    rating: 5,
    date: "Hace 1 mes",
    comment: "Impecable el trabajo, Martin muy atento y educado, gracias.",
    vehicle: "Cliente Taller Cantón"
  },
  {
    author: "nicolas manzone",
    reviewsCount: "4 opiniones",
    rating: 5,
    date: "Hace 5 meses",
    comment: "Laburan de 10. Soy cliente hace varios años.",
    vehicle: "Cliente Frecuente"
  },  
  {
    author: "Emi",
    reviewsCount: "Reseña pendiente a verificar",
    rating: 5,
    date: "Hace 2 semanas",
    comment: "Excelente atención y nivel de detalle. Lleve la moto por una caida ,se encargaron de todo el proceso ...la  terminación estética...quedó impecable. Súper recomendados en Zona Oeste.",
    vehicle: "Yamaha FZ-150 fi "
  }
];
---

<section class="py-24 bg-[#0a0a0a] border-t border-[#262626] relative overflow-hidden">
  <!-- Brillo sutil de fondo -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-red-600/5 rounded-full blur-[140px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 space-y-16 relative z-10">
    
    <!-- Encabezado de sección -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div class="space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-red-600/10 border border-red-600/30 rounded-full">
          <span class="w-2 h-2 rounded-full bg-red-600"></span>
          <span class="font-emblem text-red-500 text-[10px] tracking-widest uppercase">MIRA</span>
        </div>
        <h2 class="font-headline text-3xl sm:text-4xl text-white">
          LO QUE OPINAN <span class="text-red-600">NUESTROS CLIENTES</span>
        </h2>
      </div>
      
      <!-- Calificación global de Google Maps -->
      <div class="card-industrial px-6 py-4 flex items-center gap-4 bg-[#121212] border-neutral-800">
        <div class="text-3xl font-headline text-white">5.0</div>
        <div class="space-y-1">
          <div class="flex text-amber-500 text-sm">
            ★★★★★
          </div>
          <p class="text-[11px] text-neutral-400 font-tech">Basado en reseñas de Google Maps</p>
        </div>
      </div>
    </div>

    <!-- Grid de Reseñas -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {googleReviews.map((review) => (
        <div class="card-industrial p-6 space-y-4 bg-gradient-to-br from-[#121212] to-[#0a0a0a] border-neutral-800 hover:border-red-600/40 transition-all flex flex-col justify-between">
          
          <div class="space-y-3">
            <!-- Estrellas y Fecha -->
            <div class="flex justify-between items-center">
              <div class="flex text-amber-500 text-xs">
                {Array.from({ length: review.rating }).map(() => "★")}
              </div>
              <span class="text-[10px] text-neutral-500 font-tech">{review.date}</span>
            </div>

            <!-- Comentario -->
            <p class="text-xs text-neutral-300 font-tech leading-relaxed">
              "{review.comment}"
            </p>
          </div>

          <!-- Autor y Vehículo -->
          <div class="pt-4 border-t border-neutral-800/60 flex items-center justify-between">
            <div>
              <h4 class="font-headline text-xs text-white">{review.author}</h4>
              <span class="text-[10px] text-red-500 font-emblem">{review.vehicle}</span>
            </div>
            <!-- Icono de Google -->
            <svg class="w-4 h-4 fill-neutral-500" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
            </svg>
          </div>

        </div>
      ))}
    </div>

    <!-- Botón para ver más en Google Maps -->
    <div class="text-center pt-2">
      <a
        href="https://www.google.com/maps/place//data=!4m2!3m1!19sChIJD2cqcYO5vJURquPia4rmoZs"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-xs font-headline text-neutral-400 hover:text-white transition-colors border-b border-neutral-700 pb-1"
      >
        <span>Ver todas las reseñas en Google Maps</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
    </div>

  </div>
</section>