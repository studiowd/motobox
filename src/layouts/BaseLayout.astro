---
import "../styles/global.css";
import { getWhatsAppUrl } from "../utils/whatsapp";
import "tailwindcss";
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Taller Cantón — Chapa y pintura, mecánica de motos y terminación estética en Hurlingham, Zona Oeste.",
} = Astro.props;

const whatsappGeneralUrl = getWhatsAppUrl("general");
const whatsappTurnoUrl = getWhatsAppUrl("turno");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Taller Cantón</title>
    <meta name="description" content={description} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Krona+One&family=Space+Grotesk:wght@400;500;700&family=Syncopate:wght@700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="bg-[#0a0a0a] text-[#f5f5f5] min-h-screen flex flex-col selection:bg-red-600 selection:text-white"
  >
    <!-- Header Transparente con scroll -->
    <header
      id="site-header"
      class="fixed top-0 left-0 w-full z-50 transition-all duration-300 bg-transparent py-5"
    >
      <div class="max-w-7xl mx-auto px-6 flex items-center justify-between">
        <a
          href="/"
          class="font-headline text-lg md:text-xl tracking-wider text-white flex items-center gap-2"
        >
          TALLER <span class="text-red-600">CANTÓN</span>
        </a>

        <!-- Navegación de escritorio -->
        <nav
          class="hidden lg:flex items-center gap-8 text-sm font-medium text-neutral-300"
        >
          <a href="/" class="hover:text-white transition-smooth">Inicio</a>
          <a href="/chapa-y-pintura/" class="hover:text-white transition-smooth"
            >Chapa y pintura</a
          >
          <a
            href="/mecanica-de-motos/"
            class="hover:text-white transition-smooth">Mecánica de motos</a
          >
          <a
            href="/terminacion-estetica/"
            class="hover:text-white transition-smooth">Terminación y estética</a
          >
          <a href="/trabajos/" class="hover:text-white transition-smooth"
            >Trabajos realizados</a
          >
          <a href="/nosotros/" class="hover:text-white transition-smooth"
            >Nosotros</a
          >
        </nav>

        <!-- CTA Turno -->
        <div class="hidden lg:block">
          <a
            href={whatsappTurnoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-red-600 hover:bg-red-700 text-white text-xs font-headline px-5 py-3 rounded-none transition-smooth tracking-wider flex items-center gap-2"
          >
            Solicitar turno
          </a>
        </div>

        <!-- Botón menú móvil -->
        <button
          id="menu-toggle"
          class="lg:hidden text-white focus:outline-none p-2"
          aria-label="Abrir menú"
        >
          <svg
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>

      <!-- Menú móvil desplegable -->
      <div
        id="mobile-menu"
        class="hidden lg:hidden absolute top-full left-0 w-full bg-[#141414] border-b border-[#262626] px-6 py-6 flex flex-col gap-4"
      >
        <a
          href="/"
          class="text-neutral-200 hover:text-white text-sm font-medium"
          >Inicio</a
        >
        <a
          href="/chapa-y-pintura/"
          class="text-neutral-200 hover:text-white text-sm font-medium"
          >Chapa y pintura</a
        >
        <a
          href="/mecanica-de-motos/"
          class="text-neutral-200 hover:text-white text-sm font-medium"
          >Mecánica de motos</a
        >
        <a
          href="/terminacion-estetica/"
          class="text-neutral-200 hover:text-white text-sm font-medium"
          >Terminación y estética</a
        >
        <a
          href="/trabajos/"
          class="text-neutral-200 hover:text-white text-sm font-medium"
          >Trabajos realizados</a
        >
        <a
          href="/nosotros/"
          class="text-neutral-200 hover:text-white text-sm font-medium"
          >Nosotros</a
        >
        <a
          href={whatsappTurnoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-red-600 text-white text-center text-xs font-headline py-3 mt-2 tracking-wider"
        >
          Solicitar turno
        </a>
      </div>
    </header>

    <!-- Contenido principal -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Botón flotante de WhatsApp -->
    <a
      href={whatsappGeneralUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="fixed bottom-6 right-6 z-40 bg-[#25D366] hover:bg-[#20ba5a] text-white p-4 rounded-full shadow-2xl transition-transform hover:scale-110 flex items-center justify-center"
      aria-label="Consultar por WhatsApp"
    >
      <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24">
        <path
          d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
        ></path>
      </svg>
    </a>

    <!-- Footer Institucional -->
    <footer
      class="bg-[#141414] border-t border-[#262626] pt-16 pb-12 text-neutral-400 text-sm"
    >
      <div
        class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-4 gap-10 mb-12"
      >
        <div class="space-y-4">
          <h3 class="font-headline text-white text-base">
            TALLER <span class="text-red-600">CANTÓN</span>
          </h3>
          <p class="text-neutral-400 text-xs leading-relaxed">
            Especialistas en chapa y pintura, mecánica de motos y terminación
            estética de vehículos. Precisión técnica y calidad de trabajo en
            Zona Oeste y CABA.
          </p>
        </div>

        <div>
          <h4
            class="font-emblem text-white text-xs uppercase tracking-wider mb-4"
          >
            Especialidades
          </h4>
          <ul class="space-y-2 text-xs">
            <li>
              <a
                href="/chapa-y-pintura/"
                class="hover:text-white transition-smooth">Chapa y pintura</a>
            </li>
            <li>
              <a
                href="/mecanica-de-motos/"
                class="hover:text-white transition-smooth">Mecánica de motos</a>
            </li>
            <li>
              <a
                href="/terminacion-estetica/"
                class="hover:text-white transition-smooth"
                >Terminación y estética</a>
            </li>
          </ul>
        </div>

        <div>
          <h4
            class="font-emblem text-white text-xs uppercase tracking-wider mb-4"
          >
            Ubicación y Horarios
          </h4>
          <p class="text-xs text-neutral-400 mb-2">
            Centenera 908, Hurlingham, Provincia de Buenos Aires.
          </p>
          <p class="text-xs text-neutral-400">
            Lun a Vie: 08:00 a 18:00<br />Sáb: 08:00 a 13:00
          </p>
        </div>

        <div>
          <h4
            class="font-emblem text-white text-xs uppercase tracking-wider mb-4"
          >
            Legal
          </h4>
          <ul class="space-y-2 text-xs">
            <li>
              <a href="/privacidad/" class="hover:text-white transition-smooth"
                >Política de privacidad</a>
            </li>
            <li>
              <a href="/contacto/" class="hover:text-white transition-smooth"
                >Contacto WhatsApp</a>
            </li>
          </ul>
        </div>
      </div>

      <div
        class="max-w-7xl mx-auto px-6 pt-8 border-t border-[#262626] flex flex-col sm:flex-row items-center justify-between text-xs text-neutral-500"
      >
        <p>
          © {new Date().getFullYear()} Taller Cantón. Todos los derechos reservados.
        </p>
        <p class="mt-2 sm:mt-0">Centenera 908, Hurlingham, Buenos Aires.</p>
      </div>
    </footer>

    <!-- Script para Header scroll y menú móvil -->
    <script>
      const header = document.getElementById("site-header");
      window.addEventListener("scroll", () => {
        if (window.scrollY > 40) {
          header?.classList.add(
            "bg-[#0a0a0a]/95",
            "backdrop-blur-md",
            "shadow-lg",
            "py-3",
          );
          header?.classList.remove("bg-transparent", "py-5");
        } else {
          header?.classList.remove(
            "bg-[#0a0a0a]/95",
            "backdrop-blur-md",
            "shadow-lg",
            "py-3",
          );
          header?.classList.add("bg-transparent", "py-5");
        }
      });

      const menuToggle = document.getElementById("menu-toggle");
      const mobileMenu = document.getElementById("mobile-menu");
      menuToggle?.addEventListener("click", () => {
        mobileMenu?.classList.toggle("hidden");
      });
    </script>
  </body>
</html>
