---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getWhatsAppUrl } from "../../utils/whatsapp";

const whatsappChapa = getWhatsAppUrl("chapa");

// 1. CONFIGURACIÓN CENTRAL DE MARCA, REDES Y HORARIOS
const SITE_URL = "https://tallercanton.com.ar"; // Ajustá si tu dominio definitivo es otro

const redes = {
  // Reemplazá por el Instagram y TikTok de Taller Cantón si son distintos a @motoboxcanton
  instagram: "https://www.instagram.com/canton_carroceria_pintura/",
  instagramReels: "https://www.instagram.com/canton_carroceria_pintura/reels/",
  tiktok: "https://www.tiktok.com/@tallercanton",
  maps: "https://maps.app.goo.gl/yKuUTL5EUiTeFoF6A",
  motoBox: "/mecanica-de-motos/",
  whatsapp: whatsappChapa,
  telefonoVisible: "11 3341-9375",
  direccion: "Centenera 908, Hurlingham, Buenos Aires",
  horariosCortos: "Lun a Vie 9 a 18 hs • Sáb 9 a 13 hs",
};

// 2. ACCESOS RÁPIDOS INTERACTIVOS DEL HERO (Scroll directo a cada servicio)
const accesosHero = [
  { label: "Chapa y Desabollado", href: "#servicio-chapa" },
  { label: "Pintura Match Color", href: "#servicio-pintura" },
  { label: "Siniestros y Seguros", href: "#servicio-seguros" },
  { label: "Estética y Pulido", href: "#servicio-estetica" },
];

// 3. GRILLA DE 4 SERVICIOS DE CHAPA Y PINTURA (Con tus posters y videos actuales)
const servicios = [
  {
    id: "servicio-chapa",
    titulo: "Chapa y Desabollado",
    subtitulo: "Corrección artesanal de carrocería y estructura",
    icono: "hammer",
    poster:
      "https://pub-804fbc180fcb4c0d895ad136b3f91ede.r2.dev/images/motos/992d3667-0591-424c-bcd9-cc631bf6b963.webp",
    video: "/videos/paso1-chapa.mp4",
    mediaClass: "opacity-90",
    items: [
      "Reparación de golpes, abolladuras y bollos",
      "Escuadre y alineación de puertas, capot y guardabarros",
      "Reemplazo y ajuste de paneles y paragolpes",
      "Sacabollos artesanal y reparación de plásticos",
      "Recuperación de simetría y líneas originales de fábrica",
    ],
  },
  {
    id: "servicio-pintura",
    titulo: "Pintura y Match Color",
    subtitulo: "Colorimetría exacta y acabado de fábrica",
    icono: "spray",
    poster:
      "https://pub-804fbc180fcb4c0d895ad136b3f91ede.r2.dev/images/motos/asdasdad.webp",
    video: "/videos/paso3-pintura.mp4",
    mediaClass: "opacity-90",
    items: [
      "Igualación exacta de tono original (Match Color)",
      "Preparación minuciosa, lijado, nivelación y primer",
      "Pintura parcial de piezas o repintado integral",
      "Barnices de alto brillo y protección UV",
      "Garantía escrita en terminación y materiales",
    ],
  },
  {
    id: "servicio-seguros",
    titulo: "Siniestros y Seguros",
    subtitulo: "Gestión ágil y presupuestos para aseguradoras",
    icono: "shield",
    poster:
      "https://pub-804fbc180fcb4c0d895ad136b3f91ede.r2.dev/images/motos/asdaj3.webp",
    video: "/videos/paso2-preparacion.mp4",
    mediaClass: "opacity-90",
    items: [
      "Presupuestos detallados para presentar en tu seguro",
      "Atención a terceros, todo riesgo y daños parciales",
      "Reparación de choques leves, medios y de gran magnitud",
      "Evaluación y cotización rápida por fotos vía WhatsApp",
      "Documentación fotográfica del antes y después",
    ],
  },
  {
    id: "servicio-estetica",
    titulo: "Estética y Terminación",
    subtitulo: "Brillo profundo y cuidado exterior",
    icono: "sparkle",
    poster:
      "https://pub-804fbc180fcb4c0d895ad136b3f91ede.r2.dev/images/motos/Gemini_Generated_Image_qbvxkuqbvxkuqbvx.jfif",
    video: "/videos/taller-hero.mp4",
    mediaClass: "opacity-95 brightness-110",
    items: [
      "Pulido, abrillantado y corrección de laca",
      "Eliminación de rayones superficiales y marcas de lavado",
      "Tratamientos de protección y sellado de pintura",
      "Restauración y pulido de ópticas opacas",
      "Terminación estética integral antes de la entrega",
    ],
  },
];

// 4. TRABAJOS REALES EN REELS (Reemplazá las URLs por tus Reels reales de autos)
const trabajos = [
  {
    servicio: "Reparación y Desabollado",
    descripcion: "Etapa 01 — Recuperación de chapa y líneas de carrocería",
    src: "https://pub-804fbc180fcb4c0d895ad136b3f91ede.r2.dev/images/motos/992d3667-0591-424c-bcd9-cc631bf6b963.webp",
    alt: "Reparación y desabollado de carrocería en Taller Cantón Hurlingham",
    reelUrl: redes.instagramReels,
    badge: "Ver Reel ↗",
  },
  {
    servicio: "Preparación y Base",
    descripcion: "Etapa 02 — Nivelación, lijado y fondo protector",
    src: "https://pub-804fbc180fcb4c0d895ad136b3f91ede.r2.dev/images/motos/asdaj3.webp",
    alt: "Preparación de superficie y base para pintura automotriz en Zona Oeste",
    reelUrl: redes.instagramReels,
    badge: "Ver Reel ↗",
  },
  {
    servicio: "Pintura y Terminación",
    descripcion: "Etapa 03 — Match Color y barniz de alto brillo",
    src: "https://pub-804fbc180fcb4c0d895ad136b3f91ede.r2.dev/images/motos/asdasdad.webp",
    alt: "Pintura automotriz con igualación de color original en Hurlingham",
    reelUrl: redes.instagramReels,
    badge: "Ver Reel ↗",
  },
  {
    servicio: "Más trabajos en Instagram",
    descripcion: "Antes y después de choques, pintura y entregas",
    src: "https://pub-804fbc180fcb4c0d895ad136b3f91ede.r2.dev/images/motos/Gemini_Generated_Image_qbvxkuqbvxkuqbvx.jfif",
    alt: "Trabajos terminados de chapa y pintura en Taller Cantón Hurlingham",
    reelUrl: redes.instagramReels,
    badge: "Todos los Reels ↗",
  },
];

// 5. MARCAS DE AUTOS QUE ATENDEMOS (SEO por búsqueda de marca)
const marcasAutos = [
  "Volkswagen",
  "Ford",
  "Chevrolet",
  "Toyota",
  "Peugeot",
  "Renault",
  "Fiat",
  "Honda",
  "Nissan",
  "Citroën",
  "Jeep",
  "BMW",
  "Audi",
  "Mercedes-Benz",
];

// 6. DATOS ESTRUCTURADOS JSON-LD PARA SEO LOCAL (AutoBodyShop)
const seoSchema = {
  "@context": "https://schema.org",
  "@type": "AutoBodyShop",
  name: "Taller Cantón — Chapa y Pintura",
  url: `${SITE_URL}/chapa-y-pintura/`,
  description:
    "Taller de chapa y pintura automotriz en Hurlingham, Zona Oeste. Reparación de choques y abolladuras, pintura con Match Color, atención a particulares y presupuestos para compañías de seguros.",
  telephone: "+54-11-3341-9375",
  priceRange: "$$",
  hasMap: redes.maps,
  image:
    "https://pub-804fbc180fcb4c0d895ad136b3f91ede.r2.dev/images/motos/asdasdad.webp",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Centenera 908",
    addressLocality: "Hurlingham",
    addressRegion: "Buenos Aires",
    addressCountry: "AR",
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "09:00",
      closes: "18:00",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Saturday"],
      opens: "09:00",
      closes: "13:00",
    },
  ],
  areaServed: [
    "Hurlingham",
    "Villa Tesei",
    "William Morris",
    "El Palomar",
    "Morón",
    "Castelar",
    "Ituzaingó",
    "Zona Oeste",
  ],
  sameAs: [redes.instagram, redes.tiktok],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Servicios de Chapa y Pintura Automotriz",
    itemListElement: servicios.map((s) => ({
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: `${s.titulo} automotriz en Hurlingham`,
        description: s.items.join(". "),
      },
    })),
  },
};
---

<BaseLayout
  title="Chapa y Pintura en Hurlingham | Taller Cantón"
  description="Taller de chapa y pintura en Hurlingham, Zona Oeste. Reparación de carrocería, desabollado, pintura Match Color, estética y presupuestos para compañías de seguros."
>
  <!-- Schema JSON-LD inyectado directamente en el <head> -->
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(seoSchema)}
  />
  <!-- CDN de tsParticles -->
  <script
    src="https://cdn.jsdelivr.net/npm/@tsparticles/slim@3.3.0/tsparticles.slim.bundle.min.js"
    defer
  ></script>

  <!-- 1. HERO FULL-WIDTH CON VIDEO DE FONDO Y GRID INTERACTIVO 2x2 -->
  <section
    id="inicio"
    class="scroll-mt-28 relative min-h-[600px] flex items-center pt-16 pb-20 bg-[#080808] overflow-hidden border-b border-red-600/35"
  >
    <div class="absolute inset-0 z-0">
      <video
        class="w-full h-full object-cover object-right opacity-80 brightness-110"
        autoplay
        muted
        loop
        playsinline
        poster="https://pub-804fbc180fcb4c0d895ad136b3f91ede.r2.dev/images/motos/Gemini_Generated_Image_qbvxkuqbvxkuqbvx.jfif"
      >
        <source src="/videos/taller-hero.mp4" type="video/mp4" />
      </video>
      <div class="absolute inset-0 bg-gradient-to-r from-[#080808] via-[#080808]/75 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#080808] via-transparent to-[#080808]/45"></div>
    </div>

    <!-- Franjas diagonales estilo taller -->
    <div class="hidden lg:block absolute -left-24 top-0 h-full w-32 bg-red-600/20 -skew-x-12 border-r-2 border-red-600/50 pointer-events-none z-10"></div>
    <div class="hidden lg:block absolute -right-16 bottom-0 h-56 w-20 bg-red-600/80 -skew-x-12 pointer-events-none z-10"></div>

    <!-- Partículas interactivas (solo desktop) -->
    <div
      id="tsparticles"
      class="absolute inset-0 z-10 pointer-events-auto"
    ></div>

    <div class="max-w-7xl mx-auto px-6 relative z-20 w-full">
      <div class="max-w-2xl space-y-5">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-red-600/15 border border-red-600/40 rounded-full">
          <span class="w-2 h-2 rounded-full bg-red-600 animate-ping"></span>
          <span class="font-emblem text-red-400 text-[10px] tracking-widest uppercase">
            Taller de Chapa y Pintura en Hurlingham
          </span>
        </div>

        <h1 class="font-headline italic font-black uppercase text-4xl sm:text-6xl lg:text-7xl tracking-tight leading-[0.94] text-white">
          CHAPA Y <br />
          <span class="text-red-600 drop-shadow-[0_0_28px_rgba(220,38,38,0.55)]">
            PINTURA
          </span>
        </h1>

        <!-- Grid 2x2 interactivo con hover y scroll directo a cada servicio -->
        <ul
          aria-label="Especialidades de Taller Cantón"
          class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-w-xl pt-1"
        >
          {accesosHero.map((acceso) => (
            <li>
              <a
                href={acceso.href}
                data-scroll-link
                class="group relative overflow-hidden flex items-center justify-between gap-3 px-4 py-3 rounded-xl bg-black/55 backdrop-blur-sm border border-white/10 hover:border-red-600/80 hover:bg-red-600/15 hover:-translate-y-0.5 hover:shadow-[0_0_22px_rgba(220,38,38,0.28)] transition-all duration-300"
              >
                <span class="pointer-events-none absolute inset-0 -translate-x-full group-hover:translate-x-full transition-transform duration-700 bg-gradient-to-r from-transparent via-white/10 to-transparent -skew-x-12" />
                <span class="flex items-center gap-2.5">
                  <span class="w-1.5 h-4 bg-red-600 -skew-x-12 shrink-0 group-hover:h-5 group-hover:bg-red-500 transition-all" />
                  <span class="font-headline italic text-xs sm:text-sm text-white tracking-wide whitespace-nowrap">
                    {acceso.label}
                  </span>
                </span>
                <span class="text-red-500 text-xs opacity-50 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all">
                  →
                </span>
              </a>
            </li>
          ))}
        </ul>

        <p class="font-tech text-neutral-200 text-sm sm:text-base leading-relaxed max-w-xl pt-1">
          Devolvemos la simetría y el color original de fábrica a tu auto en
          Zona Oeste. Atención a particulares y presupuestos para compañías de
          seguros.
        </p>

        <div class="flex flex-wrap items-center gap-4 pt-3">
          <a
            href={redes.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 bg-red-600 hover:bg-red-700 text-white font-headline text-xs sm:text-sm uppercase tracking-wider px-7 py-4 rounded-xl shadow-[0_0_25px_rgba(220,38,38,0.45)] hover:scale-[1.03] transition-all"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <rect x="3" y="4" width="18" height="18" rx="2"></rect>
              <path d="M16 2v4M8 2v4M3 10h18"></path>
            </svg>
            Cotizar por WhatsApp
            <span>→</span>
          </a>

          <a
            href="#servicios"
            data-scroll-link
            class="inline-flex items-center gap-2 bg-black/55 backdrop-blur-sm border border-neutral-600 hover:border-red-600 text-neutral-200 hover:text-white font-headline text-xs sm:text-sm uppercase tracking-wider px-7 py-4 rounded-xl transition-all"
          >
            Ver servicios
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. GRILLA DE SERVICIOS 2x2 (CON VIDEO HOVER) -->
  <section id="servicios" class="scroll-mt-28 py-16 bg-[#0b0b0b] relative">
    <div class="max-w-7xl mx-auto px-6 space-y-8">
      <div class="flex items-center gap-4">
        <h2 class="font-headline italic font-black uppercase text-2xl sm:text-3xl text-white shrink-0">
          Servicios de <span class="text-red-600">Chapa y Pintura</span>
        </h2>
        <div class="h-[2px] flex-1 bg-gradient-to-r from-red-600 to-transparent"></div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {servicios.map((servicio) => (
          <article
            id={servicio.id}
            class="video-card scroll-mt-28 group relative rounded-2xl overflow-hidden border border-neutral-800 hover:border-red-600/80 bg-[#111111] shadow-2xl transition-all duration-300 min-h-[340px] flex flex-col justify-between"
          >
            <div class="absolute inset-0 z-0 overflow-hidden">
              <video
                class={`video-hover w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ${servicio.mediaClass}`}
                muted
                loop
                playsinline
                preload="none"
                poster={servicio.poster}
              >
                <source src={servicio.video} type="video/mp4" />
              </video>
              <div class="absolute inset-0 bg-gradient-to-r from-[#0d0d0d] via-[#0d0d0d]/85 to-[#0d0d0d]/15" />
              <div class="absolute inset-0 bg-gradient-to-t from-[#0d0d0d]/85 via-transparent to-[#0d0d0d]/40" />
            </div>

            <div class="relative z-10 flex items-center justify-between gap-4 border-b border-white/10 bg-black/45 backdrop-blur-[2px] pr-4">
              <div class="flex items-center gap-4">
                <div class="relative bg-gradient-to-br from-red-600 to-red-800 px-5 py-4 flex items-center justify-center shrink-0 clip-diagonal">
                  {servicio.icono === "hammer" && (
                    <svg
                      class="w-7 h-7 text-white"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"
                      />
                    </svg>
                  )}
                  {servicio.icono === "spray" && (
                    <svg
                      class="w-7 h-7 text-white"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M7 21h10a2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2zM9 10V7a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v3M12 5V3M16 4l2-1M17 7h2"
                      />
                    </svg>
                  )}
                  {servicio.icono === "shield" && (
                    <svg
                      class="w-7 h-7 text-white"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M12 3l7 4v5c0 5-3.5 8-7 9-3.5-1-7-4-7-9V7l7-4z"
                      />
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M9 12l2 2 4-4"
                      />
                    </svg>
                  )}
                  {servicio.icono === "sparkle" && (
                    <svg
                      class="w-7 h-7 text-white"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M12 3l1.9 4.6L18.5 9.5l-4.6 1.9L12 16l-1.9-4.6L5.5 9.5l4.6-1.9L12 3zM5 17l1 2.2L8.2 20 6 21l-1 2.2L4 21l-2.2-1L4 19.2 5 17z"
                      />
                    </svg>
                  )}
                </div>

                <div class="py-3">
                  <h3 class="font-headline italic font-black uppercase text-lg sm:text-xl text-white leading-tight">
                    {servicio.titulo}
                  </h3>
                  <p class="text-xs sm:text-sm italic text-neutral-300">
                    {servicio.subtitulo}
                  </p>
                </div>
              </div>

              <span
                aria-hidden="true"
                class="hidden sm:flex w-8 h-8 rounded-full bg-black/60 border border-white/15 items-center justify-center text-white/80 text-[10px] shrink-0 group-hover:opacity-0 transition-opacity"
              >
                ▶
              </span>
            </div>

            <div class="relative z-10 p-6 flex-1 flex flex-col justify-between gap-6">
              <ul class="space-y-2.5 max-w-md">
                {servicio.items.map((item) => (
                  <li class="flex items-start gap-2.5 text-xs sm:text-sm text-neutral-100">
                    <svg
                      class="w-4 h-4 text-red-600 shrink-0 mt-0.5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="3"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M5 13l4 4L19 7"
                      />
                    </svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>

              <div>
                <a
                  href={getWhatsAppUrl(
                    "chapa",
                    `Hola Taller Cantón! Quiero consultar por ${servicio.titulo} para mi auto.`,
                  )}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-black/80 border border-red-600/80 hover:bg-red-600 text-white text-xs sm:text-sm font-semibold transition-all"
                >
                  Consultar {servicio.titulo.split(" ")[0]} <span>→</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. BARRA DE CONFIANZA -->
  <section class="py-12 bg-[#080808] border-y border-neutral-800">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-0 lg:divide-x lg:divide-neutral-800">
        <div class="flex items-center justify-center gap-4 lg:px-6">
          <svg
            class="w-10 h-10 text-red-600 shrink-0"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 3l7 4v5c0 5-3.5 8-7 9-3.5-1-7-4-7-9V7l7-4z"
            ></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 12l2 2 4-4"
            ></path>
          </svg>
          <span class="text-sm sm:text-base font-semibold text-white leading-snug">
            Garantía
            <br />
            escrita
          </span>
        </div>

        <div class="flex items-center justify-center gap-4 lg:px-6">
          <svg
            class="w-10 h-10 text-red-600 shrink-0"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 12h6m-6 4h6m2 5H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5.586a1 1 0 0 1 .707.293l5.414 5.414a1 1 0 0 1 .293.707V19a2 2 0 0 1-2 2z"
            ></path>
          </svg>
          <span class="text-sm sm:text-base font-semibold text-white leading-snug">
            Presupuestos
            <br />
            para seguros
          </span>
        </div>

        <div class="flex items-center justify-center gap-4 lg:px-6">
          <svg
            class="w-10 h-10 text-red-600 shrink-0"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            viewBox="0 0 24 24"
          >
            <circle cx="12" cy="12" r="9"></circle>
