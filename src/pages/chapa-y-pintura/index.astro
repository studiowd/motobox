---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getWhatsAppUrl } from '../../utils/whatsapp';

const whatsappChapa = getWhatsAppUrl('chapa');
---

<BaseLayout title="Chapa y Pintura" description="Especialistas en reparación de choques, paneles metálicos, preparación de superficies y pintura integral en Taller Cantón.">
  <section class="pt-32 pb-16 bg-[#141414] border-b border-[#262626]">
    <div class="max-w-7xl mx-auto px-6 space-y-4">
      <span class="font-emblem text-red-500 text-xs tracking-widest uppercase">Especialidad 01</span>
      <h1 class="font-headline text-3xl md:text-5xl text-white">Chapa y Pintura</h1>
      <p class="font-tech text-neutral-300 text-sm md:text-base max-w-2xl leading-relaxed">
        Reparación de carrocería, paneles metálicos, preparación de superficies y pintura con acabados de máxima fidelidad técnica.
      </p>
    </div>
  </section>

  <section class="py-20 bg-[#0a0a0a]">
    <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-3 gap-12">
      <div class="lg:col-span-2 space-y-8">
        <div class="space-y-4">
          <h2 class="font-headline text-xl text-white">Servicios confirmados</h2>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs text-neutral-300">
            <li class="card-industrial p-4">Reparación de choques y siniestros</li>
            <li class="card-industrial p-4">Reparación de golpes y abolladuras (chapa convencional)</li>
            <li class="card-industrial p-4">Reparación de paneles metálicos</li>
            <li class="card-industrial p-4">Puertas, capot, guardabarros y laterales</li>
            <li class="card-industrial p-4">Preparación de superficies, lijado y masillado</li>
            <li class="card-industrial p-4">Pintura integral, parcial y por piezas</li>
            <li class="card-industrial p-4">Retoques y restauración de carrocería</li>
            <li class="card-industrial p-4">Reemplazo de paneles sujeto a evaluación</li>
          </ul>
        </div>
      </div>

      <div class="card-industrial p-6 space-y-6 h-fit">
        <h3 class="font-headline text-white text-base">Consulta por WhatsApp</h3>
        <p class="text-xs text-neutral-400 leading-relaxed">
          Comunícate directamente para coordinar una evaluación de tu vehículo en nuestro taller de Hurlingham.
        </p>
        <a href={whatsappChapa} target="_blank" rel="noopener noreferrer" class="block w-full text-center bg-red-600 hover:bg-red-700 text-white font-headline text-xs py-4 transition-smooth">
          Consultar chapa y pintura
        </a>
      </div>
    </div>
  </section>
</BaseLayout>