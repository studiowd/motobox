---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getWhatsAppUrl } from '../../utils/whatsapp';

const whatsappEstetica = getWhatsAppUrl('estetica');
---

<BaseLayout title="Terminación y Estética" description="Pulido de pintura, abrillantado, corrección de defectos superficiales y recuperación estética en Taller Cantón.">
  <section class="pt-32 pb-16 bg-[#141414] border-b border-[#262626]">
    <div class="max-w-7xl mx-auto px-6 space-y-4">
      <span class="font-emblem text-red-500 text-xs tracking-widest uppercase">Especialidad 03</span>
      <h1 class="font-headline text-3xl md:text-5xl text-white">Terminación y Estética</h1>
      <p class="font-tech text-neutral-300 text-sm md:text-base max-w-2xl leading-relaxed">
        Cuidado extremo del detalle, pulido de pintura y recuperación estética aplicable a automóviles y motocicletas.
      </p>
    </div>
  </section>

  <section class="py-20 bg-[#0a0a0a]">
    <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-3 gap-12">
      <div class="lg:col-span-2 space-y-8">
        <div class="space-y-4">
          <h2 class="font-headline text-xl text-white">Servicios confirmados</h2>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs text-neutral-300">
            <li class="card-industrial p-4">Lijado de superficies</li>
            <li class="card-industrial p-4">Preparación de paneles</li>
            <li class="card-industrial p-4">Pulido de pintura</li>
            <li class="card-industrial p-4">Abrillantado</li>
            <li class="card-industrial p-4">Corrección de defectos superficiales</li>
            <li class="card-industrial p-4">Terminación de pintura y piezas</li>
            <li class="card-industrial p-4">Recuperación estética de piezas y superficies</li>
          </ul>
        </div>
      </div>

      <div class="card-industrial p-6 space-y-6 h-fit">
        <h3 class="font-headline text-white text-base">Consulta por WhatsApp</h3>
        <p class="text-xs text-neutral-400 leading-relaxed">
          Asesoramiento personalizado sobre pulido y terminación estética para tu vehículo.
        </p>
        <a href={whatsappEstetica} target="_blank" rel="noopener noreferrer" class="block w-full text-center bg-red-600 hover:bg-red-700 text-white font-headline text-xs py-4 transition-smooth">
          Consultar estética
        </a>
      </div>
    </div>
  </section>
</BaseLayout>