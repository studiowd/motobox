---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getWhatsAppUrl } from "../../utils/whatsapp";

const whatsappMecanica = getWhatsAppUrl("mecanica");

// 1. CONFIGURACIÓN CENTRAL DE MARCA, REDES Y HORARIOS
const SITE_URL = "https://tallercanton.com.ar"; // Ajustá si tu dominio definitivo es otro

const redes = {
  instagram: "https://www.instagram.com/motoboxcanton/",
  instagramReels: "https://www.instagram.com/motoboxcanton/reels/",
  tiktok: "https://www.tiktok.com/@motoboxcanton",
  maps: "https://maps.app.goo.gl/yKuUTL5EUiTeFoF6A",
  webPadre: "/",
  whatsapp: whatsappMecanica,
  telefonoVisible: "11 2178-7278",
  direccion: "Centenera 908, Hurlingham, Buenos Aires",
  horariosCortos: "Lun a Vie 9 a 18 hs • Sáb 9 a 13 hs",
};

// 2. NAVEGACIÓN INTERNA SCROLLEABLE DE MOTO BOX
const navInterna = [
  { id: "inicio", label: "Inicio" },
  { id: "servicios", label: "Servicios" },
  { id: "trabajos", label: "Nuestro Trabajo" },
  { id: "taller", label: "El Taller" },
  { id: "redes", label: "Redes" },
];

// 3. ACCESOS RÁPIDOS INTERACTIVOS DEL HERO (Todos scrollean directo dentro de la página)
const accesosHero = [
  { label: "Mecánica Integral", href: "#servicio-motor" },
  { label: "Service Preventivo", href: "#servicio-preventivo" },
  { label: "Scanner JDiag M400", href: "#servicio-scanner" },
  { label: "Pintura y Estética", href: "#servicio-estetica" },
];

// 4. GRILLA DE 6 SERVICIOS DE MOTO BOX (3 filas x 2 columnas)
const servicios = [
  {
    id: "servicio-preventivo",
    titulo: "Service Preventivo",
    subtitulo: "Mantenimiento según manual para tu moto",
    icono: "wrench",
    poster:
      "https://pub-804fbc180fcb4c0d895ad136b3f91ede.r2.dev/images/motos/aprilia-457-service.webp",
    video: "/videos/service-preventivo.mp4",
    mediaClass: "opacity-90",
    items: [
      "Cambio de aceites sintéticos certificados",
      "Reemplazo de filtros de aceite, aire y combustible",
      "Control y ajuste de fluidos y niveles generales",
      "Limpieza, lubricación y tensado de cadena",
      "Chequeo general de seguridad y tornillería",
    ],
  },
  {
    id: "servicio-frenos",
    titulo: "Frenos y Transmisión",
    subtitulo: "Rendimiento y seguridad en cada viaje",
    icono: "disc",
    poster:
      "https://pub-804fbc180fcb4c0d895ad136b3f91ede.r2.dev/images/motos/service-fz.jpeg",
    video: "/videos/transmision-frenos.mp4",
    mediaClass: "opacity-90",
    items: [
      "Reemplazo de pastillas y discos de freno",
      "Purgado y cambio de líquido de frenos",
      "Kit de transmisión (cadena, corona y piñón)",
      "Revisión de embrague, cables y comandos",
      "Control de suspensión, barrales y rodamientos",
    ],
  },
  {
    id: "servicio-motor",
    titulo: "Inyección y Motor",
    subtitulo: "Potencia, afinación y precisión mecánica",
    icono: "engine",
    poster:
      "https://pub-804fbc180fcb4c0d895ad136b3f91ede.r2.dev/images/motos/123_C.webp",
    video: "/videos/motor-performance.mp4",
    mediaClass: "opacity-90",
    items: [
      "Limpieza de cuerpos de mariposa e inyectores",
      "Regulación de válvulas y distribución",
      "Carburación, sincronización y puesta a punto",
      "Armado y reparación integral de motor",
      "Ajuste exclusivo con torquímetros calibrados",
    ],
  },
  {
    id: "servicio-scanner",
    titulo: "Scanner JDiag M400 Pro",
    subtitulo: "Diagnóstico computarizado multimarca",
    icono: "scanner",
    poster:
      "https://pub-804fbc180fcb4c0d895ad136b3f91ede.r2.dev/images/motos/mantenimiento-de-motos-speedy-2.jpg",
    video: "/videos/mecanica-hero.mp4",
    mediaClass: "opacity-95 brightness-125 contrast-110",
    items: [
      "Escaneo de motor, inyección electrónica y ABS",
      "Lectura de datos en tiempo real y prueba de actuadores",
      "Borrado de fallas, reset de ECU y luz de service",
      "Test profesional de batería, arranque y sistema de carga",
      "Diagnóstico completo previo a compra o viaje",
    ],
  },
  {
    id: "servicio-escapes",
    titulo: "Escapes y Performance",
    subtitulo: "Instalación de Full System y accesorios",
    icono: "exhaust",
    poster:
      "https://pub-804fbc180fcb4c0d895ad136b3f91ede.r2.dev/images/motos/aprilia-457-service.webp",
    video: "/videos/service-preventivo.mp4",
    mediaClass: "opacity-90",
    items: [
      "Instalación de escapes Full System y Slip-On",
      "Colocación y ajuste de dB killer y abrazaderas",
      "Filtros de aire de alto flujo y bujías iridium",
      "Instalación de sliders, defensas y accesorios",
      "Control de puesta a punto posterior al montaje",
    ],
  },
  {
    id: "servicio-estetica",
    titulo: "Chapa, Pintura y Estética",
    subtitulo: "Terminación de taller para tu moto",
    icono: "paint",
    // Tip: cuando subas a R2 una foto de la Benelli TNT 300 pintada, reemplazá este poster
    poster:
      "https://pub-804fbc180fcb4c0d895ad136b3f91ede.r2.dev/images/motos/service-fz.jpeg",
    video: "/videos/transmision-frenos.mp4",
    mediaClass: "opacity-90",
    items: [
      "Reparación y pintura de tanques, cachas y plásticos",
      "Arreglo estético de caídas, rayones y golpes",
      "Pintura integral, parcial y personalización",
      "Pulido, abrillantado y protección de pintura",
      "Respaldo directo de cabina y colorimetría Taller Cantón",
    ],
  },
];

// 5. NUESTRO TRABAJO: Links limpios a tus Reels reales de @motoboxcanton
const trabajos = [
  {
    servicio: "Aprilia RS 457 — Full System",
    descripcion: "Instalación de escape completo y sonido sin dB killer",
    src: "https://pub-804fbc180fcb4c0d895ad136b3f91ede.r2.dev/images/motos/aprilia-457-service.webp",
    alt: "Instalación de escape Full System en Aprilia RS 457 en Moto Box Hurlingham",
    reelUrl: "https://www.instagram.com/reel/Df-7vjatlpm/",
    badge: "Ver Reel ↗",
  },
  {
    servicio: "Benelli TNT 300 — Pintura",
    descripcion: "Trabajo de chapa y pintura en el taller",
    // Tip: cuando tengas la foto de la Benelli en R2, pegala acá
    src: "https://pub-804fbc180fcb4c0d895ad136b3f91ede.r2.dev/images/motos/service-fz.jpeg",
    alt: "Benelli TNT 300 tras pasar por chapa y pintura en Moto Box Taller Cantón",
    reelUrl: "https://www.instagram.com/reel/DgKTxWRTifi/",
    badge: "Ver Reel ↗",
  },
  {
    servicio: "Aprilia RS 457 — En el Taller",
    descripcion: "Detalle del trabajo y terminación en Moto Box",
    src: "https://pub-804fbc180fcb4c0d895ad136b3f91ede.r2.dev/images/motos/123_C.webp",
    alt: "Aprilia RS 457 en Moto Box by Taller Cantón Hurlingham",
    reelUrl: "https://www.instagram.com/reel/Df8ivwitAjB/",
    badge: "Ver Reel ↗",
  },
  {
    servicio: "Más trabajos en @motoboxcanton",
    descripcion: "Services, scanner JDiag M400 Pro y entregas semanales",
    src: "https://pub-804fbc180fcb4c0d895ad136b3f91ede.r2.dev/images/motos/mantenimiento-de-motos-speedy-2.jpg",
    alt: "Todos los Reels de mecánica de motos de Moto Box en Instagram",
    reelUrl: redes.instagramReels,
    badge: "Todos los Reels ↗",
  },
];

// 6. MARCAS CUBIERTAS CON JDIAG M400 PRO (SEO por búsqueda de marca)
const marcas = [
  "Honda",
  "Yamaha",
  "Suzuki",
  "Kawasaki",
  "Bajaj",
  "Benelli",
  "Aprilia",
  "KTM",
  "BMW",
  "Ducati",
  "Triumph",
  "Harley-Davidson",
  "Royal Enfield",
  "CFMoto",
  "Voge",
  "Kymco",
  "SYM",
  "Vespa / Piaggio",
  "Hero",
  "TVS",
];

// 7. DATOS ESTRUCTURADOS JSON-LD COMPLETOS PARA SEO LOCAL EN GOOGLE
const seoSchema = {
  "@context": "https://schema.org",
  "@type": "MotorcycleRepair",
  name: "Moto Box — Taller Cantón",
  alternateName: "Moto Box by Taller Cantón",
  url: `${SITE_URL}/mecanica-de-motos/`,
  description:
    "Taller mecánico de motos multimarca en Hurlingham, Zona Oeste. Service preventivo, mecánica integral, frenos, transmisión, instalación de escapes Full System, chapa y pintura de motos y diagnóstico computarizado con scanner JDiag M400 Pro.",
  telephone: "+54-11-3341-9375",
  priceRange: "$$",
  hasMap: redes.maps,
  image:
    "https://pub-804fbc180fcb4c0d895ad136b3f91ede.r2.dev/images/motos/aprilia-457-service.webp",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Centenera 908",
    addressLocality: "Hurlingham",
    addressRegion: "Buenos Aires",
    addressCountry: "AR",
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "09:00",
      closes: "18:00",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Saturday"],
      opens: "09:00",
      closes: "13:00",
    },
  ],
  areaServed: [
    "Hurlingham",
    "Villa Tesei",
    "William Morris",
    "El Palomar",
    "Morón",
    "Castelar",
    "Ituzaingó",
    "Zona Oeste",
  ],
  parentOrganization: {
    "@type": "AutoRepair",
    name: "Taller Cantón — Chapa y Pintura",
    url: SITE_URL,
  },
  sameAs: [redes.instagram, redes.tiktok],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Servicios de Mecánica, Diagnóstico y Pintura de Motos",
    itemListElement: servicios.map((s) => ({
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: `${s.titulo} para motos en Hurlingham`,
        description: s.items.join(". "),
      },
    })),
  },
};
---

<BaseLayout
  title="Moto Box by Taller Cantón | Mecánica de Motos, Scanner JDiag y Pintura en Hurlingham"
  description="Moto Box en Hurlingham, Zona Oeste. Service preventivo, mecánica integral multimarca, diagnóstico con scanner JDiag M400 Pro, instalación de escapes Full System y chapa y pintura para motos."
  hideHeader={true}
>
  <!-- Schema JSON-LD inyectado directamente en el <head> -->
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(seoSchema)}
  />
  <!-- CDN de tsParticles -->
  <script
    src="https://cdn.jsdelivr.net/npm/@tsparticles/slim@3.3.0/tsparticles.slim.bundle.min.js"
    defer
  ></script>

  <!-- NAVEGACIÓN INTERNA PROPIA DE MOTO BOX (STICKY + SCROLL ANIMADO) -->
  <nav
    id="motobox-nav"
    aria-label="Navegación interna de Moto Box"
    class="sticky top-0 z-50 bg-[#080808]/95 backdrop-blur-md border-b border-red-600/30 shadow-lg"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
      <!-- Identidad Submarca + Enlace a Marca Padre -->
      <div class="flex items-center gap-3 shrink-0">
        <a
          href="#inicio"
          data-scroll-link
          class="flex items-center gap-2.5 group"
        >
          <span class="w-2.5 h-6 bg-red-600 -skew-x-12 inline-block group-hover:scale-y-110 transition-transform"></span>
          <div class="leading-none">
            <span class="font-headline italic font-black text-base sm:text-lg text-white tracking-tight block">
              MOTO <span class="text-red-600">BOX</span>
            </span>
            <span class="font-emblem text-[9px] text-neutral-400 uppercase tracking-widest block">
              by Taller Cantón
            </span>
          </div>
        </a>

        <span class="hidden md:inline-block h-6 w-px bg-neutral-800"></span>

        <a
          href={redes.webPadre}
          class="hidden md:inline-flex items-center gap-1 text-[11px] text-neutral-400 hover:text-white transition-colors"
          title="Volver a Taller Cantón Chapa y Pintura"
        >
          <span>←</span> Taller Cantón
        </a>
      </div>

      <!-- Links internos con estado activo automático -->
      <ul class="flex items-center gap-1 sm:gap-2 overflow-x-auto no-scrollbar py-1">
        {navInterna.map((item, idx) => (
          <li class="shrink-0">
            <a
              href={`#${item.id}`}
              data-scroll-link
              data-section-target={item.id}
              class={`nav-pill px-3 py-1.5 rounded-lg text-xs font-headline uppercase tracking-wider transition-all duration-300 ${
                idx === 0
                  ? "bg-red-600/20 text-white border border-red-600/60"
                  : "text-neutral-300 hover:text-white hover:bg-white/5 border border-transparent"
              }`}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <!-- Botón rápido a Turnos -->
      <a
        href="#turno"
        data-scroll-link
        class="hidden sm:inline-flex items-center gap-2 bg-red-600 hover:bg-red-700 text-white font-headline text-[11px] uppercase tracking-wider px-4 py-2 rounded-lg shadow-md shadow-red-600/30 transition-all shrink-0"
      >
        Pedir Turno →
      </a>
    </div>
  </nav>

  <!-- 1. HERO FULL-WIDTH CON GRID INTERACTIVO 2x2 -->
  <section
    id="inicio"
    class="scroll-mt-20 relative min-h-[600px] flex items-center pt-16 pb-20 bg-[#080808] overflow-hidden border-b border-red-600/35"
  >
    <div class="absolute inset-0 z-0">
      <video
        class="w-full h-full object-cover object-right opacity-80 brightness-110"
        autoplay
        muted
        loop
        playsinline
        poster="https://pub-804fbc180fcb4c0d895ad136b3f91ede.r2.dev/images/motos/mantenimiento-de-motos-speedy-2.jpg"
      >
        <source src="/videos/mecanica-hero.mp4" type="video/mp4" />
      </video>
      <div class="absolute inset-0 bg-gradient-to-r from-[#080808] via-[#080808]/75 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#080808] via-transparent to-[#080808]/45"></div>
    </div>

    <!-- Franjas diagonales estilo racing -->
    <div class="hidden lg:block absolute -left-24 top-0 h-full w-32 bg-red-600/20 -skew-x-12 border-r-2 border-red-600/50 pointer-events-none z-10"></div>
    <div class="hidden lg:block absolute -right-16 bottom-0 h-56 w-20 bg-red-600/80 -skew-x-12 pointer-events-none z-10"></div>

    <!-- Partículas interactivas (solo desktop para cuidar velocidad móvil) -->
    <div
      id="tsparticles"
      class="absolute inset-0 z-10 pointer-events-auto"
    ></div>

    <div class="max-w-7xl mx-auto px-6 relative z-20 w-full">
      <div class="max-w-2xl space-y-5">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-red-600/15 border border-red-600/40 rounded-full">
          <span class="w-2 h-2 rounded-full bg-red-600 animate-ping"></span>
          <span class="font-emblem text-red-400 text-[10px] tracking-widest uppercase">
            Taller de Motos en Hurlingham
          </span>
        </div>

        <h1 class="font-headline italic font-black uppercase text-4xl sm:text-6xl lg:text-7xl tracking-tight leading-[0.94] text-white">
          MOTO BOX <br />
          <span class="text-red-600 drop-shadow-[0_0_28px_rgba(220,38,38,0.55)]">
            MECÁNICA DE MOTOS
          </span>
        </h1>

        <!-- Grid 2x2 interactivo con hover racing y scroll directo a cada tarjeta -->
        <ul
          aria-label="Especialidades de Moto Box"
          class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-w-xl pt-1"
        >
          {accesosHero.map((acceso) => (
            <li>
              <a
                href={acceso.href}
                data-scroll-link
                class="group relative overflow-hidden flex items-center justify-between gap-3 px-4 py-3 rounded-xl bg-black/55 backdrop-blur-sm border border-white/10 hover:border-red-600/80 hover:bg-red-600/15 hover:-translate-y-0.5 hover:shadow-[0_0_22px_rgba(220,38,38,0.28)] transition-all duration-300"
              >
                <span class="pointer-events-none absolute inset-0 -translate-x-full group-hover:translate-x-full transition-transform duration-700 bg-gradient-to-r from-transparent via-white/10 to-transparent -skew-x-12" />
                <span class="flex items-center gap-2.5">
                  <span class="w-1.5 h-4 bg-red-600 -skew-x-12 shrink-0 group-hover:h-5 group-hover:bg-red-500 transition-all" />
                  <span class="font-headline italic text-xs sm:text-sm text-white tracking-wide whitespace-nowrap">
                    {acceso.label}
                  </span>
                </span>
                <span class="text-red-500 text-xs opacity-50 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all">
                  →
                </span>
              </a>
            </li>
          ))}
        </ul>

        <p class="font-tech text-neutral-200 text-sm sm:text-base leading-relaxed max-w-xl pt-1">
          Mantenimiento preventivo, diagnóstico computarizado{" "}
          <strong class="text-white">JDiag M400 Pro</strong>, instalación de
          escapes y pintura para tu moto en Zona Oeste, con herramientas
          calibradas y presupuestos claros.
        </p>

        <div class="flex flex-wrap items-center gap-4 pt-3">
          <a
            href={redes.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 bg-red-600 hover:bg-red-700 text-white font-headline text-xs sm:text-sm uppercase tracking-wider px-7 py-4 rounded-xl shadow-[0_0_25px_rgba(220,38,38,0.45)] hover:scale-[1.03] transition-all"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <rect x="3" y="4" width="18" height="18" rx="2"></rect>
              <path d="M16 2v4M8 2v4M3 10h18"></path>
            </svg>
            Solicitá tu turno
            <span>→</span>
          </a>

          <a
            href="#servicios"
            data-scroll-link
            class="inline-flex items-center gap-2 bg-black/55 backdrop-blur-sm border border-neutral-600 hover:border-red-600 text-neutral-200 hover:text-white font-headline text-xs sm:text-sm uppercase tracking-wider px-7 py-4 rounded-xl transition-all"
          >
            Ver servicios
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. GRILLA DE SERVICIOS (6 TARJETAS: 3 FILAS x 2 COLUMNAS) -->
  <section id="servicios" class="scroll-mt-20 py-16 bg-[#0b0b0b] relative">
    <div class="max-w-7xl mx-auto px-6 space-y-8">
      <div class="flex items-center gap-4">
        <h2 class="font-headline italic font-black uppercase text-2xl sm:text-3xl text-white shrink-0">
          Servicios de <span class="text-red-600">Mecánica y Estética</span>
        </h2>
        <div class="h-[2px] flex-1 bg-gradient-to-r from-red-600 to-transparent"></div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {servicios.map((servicio) => (
          <article
            id={servicio.id}
            class="video-card scroll-mt-24 group relative rounded-2xl overflow-hidden border border-neutral-800 hover:border-red-600/80 bg-[#111111] shadow-2xl transition-all duration-300 min-h-[340px] flex flex-col justify-between"
          >
            <div class="absolute inset-0 z-0 overflow-hidden">
              <video
                class={`video-hover w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ${servicio.mediaClass}`}
                muted
                loop
                playsinline
                preload="none"
                poster={servicio.poster}
              >
                <source src={servicio.video} type="video/mp4" />
              </video>
              <div class="absolute inset-0 bg-gradient-to-r from-[#0d0d0d] via-[#0d0d0d]/85 to-[#0d0d0d]/15" />
              <div class="absolute inset-0 bg-gradient-to-t from-[#0d0d0d]/85 via-transparent to-[#0d0d0d]/40" />
            </div>

            <div class="relative z-10 flex items-center justify-between gap-4 border-b border-white/10 bg-black/45 backdrop-blur-[2px] pr-4">
              <div class="flex items-center gap-4">
                <div class="relative bg-gradient-to-br from-red-600 to-red-800 px-5 py-4 flex items-center justify-center shrink-0 clip-diagonal">
                  {servicio.icono === "wrench" && (
                    <svg
                      class="w-7 h-7 text-white"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"
                      />
                    </svg>
                  )}
                  {servicio.icono === "disc" && (
                    <svg
                      class="w-7 h-7 text-white"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      viewBox="0 0 24 24"
                    >
                      <circle cx="12" cy="12" r="9" />
                      <circle cx="12" cy="12" r="3" />
                      <path d="M12 3v3M12 18v3M3 12h3M18 12h3" />
                    </svg>
                  )}
                  {servicio.icono === "engine" && (
                    <svg
                      class="w-7 h-7 text-white"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M4 10h2l2-2h6l2 2h3a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1h-3l-2 2H8l-2-2H4a1 1 0 0 1-1-1v-5a1 1 0 0 1 1-1zM9 5h6M12 5v3"
                      />
