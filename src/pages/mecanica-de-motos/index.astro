  <!-- Script combinado: Partículas (solo desktop) + Videos Hover + Scroll suave con destello + Nav activo -->
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      // 1. Inicializar tsParticles solo en desktop/tablet para mejorar Core Web Vitals en celular
      const particlesContainer = (window as any).tsParticles;
      if (
        window.innerWidth >= 768 &&
        particlesContainer &&
        typeof particlesContainer.load === "function"
      ) {
        particlesContainer.load({
          id: "tsparticles",
          options: {
            background: { color: { value: "transparent" } },
            fpsLimit: 60,
            interactivity: {
              events: { onHover: { enable: true, mode: "repulse" } },
              modes: { repulse: { distance: 80, duration: 0.4 } },
            },
            particles: {
              color: { value: ["#dc2626", "#ffffff", "#525252"] },
              links: {
                color: "#dc2626",
                distance: 130,
                enable: true,
                opacity: 0.12,
                width: 1,
              },
              move: {
                enable: true,
                speed: 1,
                random: true,
                outModes: { default: "out" },
              },
              number: { density: { enable: true, area: 950 }, value: 32 },
              opacity: { value: { min: 0.15, max: 0.6 } },
              size: { value: { min: 1, max: 2.5 } },
            },
            detectRetina: true,
          },
        });
      }

      // 2. Videos Hover acotados a .video-card
      const videoCards = document.querySelectorAll(".video-card");
      videoCards.forEach((card) => {
        const video = card.querySelector(
          ".video-hover",
        ) as HTMLVideoElement | null;
        if (video) {
          card.addEventListener("mouseenter", () => {
            video.play().catch(() => {});
          });
          card.addEventListener("mouseleave", () => {
            video.pause();
            video.currentTime = 0;
          });
        }
      });

      // 3. Scroll suave + resaltado temporal si el destino es una tarjeta de servicio
      const nav = document.getElementById("motobox-nav");
      const scrollLinks = document.querySelectorAll("[data-scroll-link]");

      scrollLinks.forEach((link) => {
        link.addEventListener("click", (e) => {
          const href = link.getAttribute("href");
          if (!href || !href.startsWith("#")) return;
          const target = document.querySelector<HTMLElement>(href);
          if (!target) return;

          e.preventDefault();
          const navHeight = nav ? nav.offsetHeight : 64;
          const topPosition =
            target.getBoundingClientRect().top +
            window.scrollY -
            navHeight -
            16;

          window.scrollTo({
            top: topPosition,
            behavior: "smooth",
          });

          if (target.classList.contains("video-card")) {
            target.classList.add(
              "ring-2",
              "ring-red-600",
              "shadow-[0_0_35px_rgba(220,38,38,0.45)]",
            );
            setTimeout(() => {
              target.classList.remove(
                "ring-2",
                "ring-red-600",
                "shadow-[0_0_35px_rgba(220,38,38,0.45)]",
              );
            }, 1500);
          }
        });
      });

      // 4. Resaltado automático de la sección activa en el Nav interno
      const navPills =
        document.querySelectorAll<HTMLAnchorElement>(".nav-pill");
      const sectionIds = ["inicio", "servicios", "trabajos", "taller", "redes"];
      const sections = sectionIds
        .map((id) => document.getElementById(id))
        .filter((el): el is HTMLElement => el !== null);

      const setActivePill = (activeId: string) => {
        navPills.forEach((pill) => {
          const isMatch = pill.dataset.sectionTarget === activeId;
          pill.classList.toggle("bg-red-600/20", isMatch);
          pill.classList.toggle("text-white", isMatch);
          pill.classList.toggle("border-red-600/60", isMatch);
          pill.classList.toggle("text-neutral-300", !isMatch);
          pill.classList.toggle("border-transparent", !isMatch);
        });
      };

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              setActivePill(entry.target.id);
            }
          });
        },
        { rootMargin: "-35% 0px -55% 0px", threshold: 0.05 },
      );

      sections.forEach((section) => observer.observe(section));
    });
  </script>
