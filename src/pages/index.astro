    .media-number[data-astro-cid-j7pv25f6]{color:#a20909;font-size:19px;font-weight:800;letter-spacing:0.1em}
    .media-number[data-astro-cid-j7pv25f6]:hover {
      color:#151414;
    }
    .preventive-overlay[data-astro-cid-j7pv25f6] p[data-astro-cid-j7pv25f6] {

      font-size:clamp(2.7rem,5vw,3.5rem);
